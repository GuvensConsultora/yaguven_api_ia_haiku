<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Panel de previsualización del adjunto (la factura del proveedor) al lado
         del presupuesto, igual que en las facturas (account.move). -->
    <record id="purchase_order_form_attachment_preview" model="ir.ui.view">
        <field name="name">purchase.order.form.attachment.preview.ia.haiku</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <div class="o_attachment_preview"/>
            </xpath>
            <!-- Solo en OC cargadas por IA: ocultamos el "Subir factura" nativo y
                 mostramos un botón directo "Crear factura" que crea la factura con
                 las cantidades completas de la OC + fecha y nro de la factura. -->
            <xpath expr="//widget[@name='purchase_file_uploader']" position="before">
                <field name="ia_haiku_origin" invisible="1"/>
                <button name="action_ia_create_invoice" type="object"
                        string="Crear factura" class="btn-primary"
                        invisible="state != 'purchase' or not ia_haiku_origin or invoice_status == 'invoiced'"/>
            </xpath>
            <xpath expr="//widget[@name='purchase_file_uploader']" position="attributes">
                <attribute name="invisible">state != 'purchase' or ia_haiku_origin</attribute>
            </xpath>
        </field>
    </record>
</odoo>
