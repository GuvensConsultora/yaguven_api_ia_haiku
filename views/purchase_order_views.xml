<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Panel de previsualización del adjunto (la factura del proveedor) al lado
         del presupuesto, igual que en las facturas (account.move). -->
    <record id="purchase_order_form_attachment_preview" model="ir.ui.view">
        <field name="name">purchase.order.form.attachment.preview.ia.haiku</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <div class="o_attachment_preview"/>
            </xpath>
            <!-- En todas las OC: reemplazamos el "Subir factura" nativo por un botón
                 directo "Crear factura" que crea la factura con las cantidades
                 completas de la OC (y fecha/nro si la cargó el wizard de IA). -->
            <xpath expr="//widget[@name='purchase_file_uploader']" position="replace">
                <button name="action_ia_create_invoice" type="object"
                        string="Crear factura" class="btn-primary"
                        invisible="state != 'purchase' or invoice_status == 'invoiced'"/>
            </xpath>
            <!-- Columna Nro Serie en las líneas de la OC: muestra las series
                 leídas de la factura del proveedor; editable. -->
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="after">
                <field name="ia_serials_display" string="Nro Serie" optional="show"
                       placeholder="Series leídas..."/>
            </xpath>
        </field>
    </record>
</odoo>
