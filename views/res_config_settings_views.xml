<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ia_haiku" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.yaguven.ia.haiku</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="IA Haiku — Carga de presupuestos"
                       id="yaguven_ia_haiku_block">
                    <setting string="API Key (Claude Haiku)"
                             help="Credencial de la API de Anthropic para leer PDF de
                                   presupuestos de compra con IA.">
                        <field name="api_ia_haiku_api_key" password="True"
                               placeholder="sk-ant-..."/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
